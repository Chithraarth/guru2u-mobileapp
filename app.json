{
  "expo": {
    "name": "Guru 2 u",
    "slug": "persona-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "persona-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of a face or palm to get a reading.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of a face or palm to get a reading.",
        "NSMicrophoneUsageDescription": "Record your voice or a conversation to get a reading."
      },
      "backgroundColor": "#0E0812",
      "bundleIdentifier": "com.guru2u.app",
      "buildNumber": "5",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.personamobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#24104A"
      },
      "backgroundColor": "#0E0812"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-27.js",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0E0812"
        }
      ],
      "./plugins/withWindowsNinjaFix.js",
      "./plugins/withReleaseSigning.js",
      "expo-localization",
      "expo-audio",
      "expo-asset",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.291497895574-42b52v9lmfv7venfhpmrec00qtjkfm56"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0E0812"
  }
}
